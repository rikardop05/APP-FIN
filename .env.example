# APPFIN — variaveis de ambiente
# Copie para .env.local e preencha. NUNCA versione o arquivo preenchido
# nem cole segredo em codigo (CONVENTIONS §9).

# --- Banco (T-002) ---
# Postgres (Neon/Supabase). Connection string com sslmode=require.
# Em PRODUCAO (Vercel Functions) use o endpoint POOLED do Neon (o que tem
# `-pooler-` no host): cada instancia serverless abre o proprio pool e o
# pooler multiplexa. Ver docs/DEPLOY.md §1. Migrations (`npm run db:migrate`)
# rodam da sua maquina, apontando DATABASE_URL para a conexao DIRETA.
DATABASE_URL=
# Deixe vazio (= false) quando a URL apontar para o pooler de transacao do
# Supabase, que nao aceita prepared statement nomeado. Em conexao direta, ou no
# endpoint pooled do Neon (que aceita), pode por true e ganhar desempenho.
DATABASE_PREPARE=

# --- Autenticacao (T-004) ---
# Segredo de assinatura da sessao Auth.js. Gerar com: npx auth secret.
# Em PRODUCAO gere um NOVO (nunca reuse o de desenvolvimento) e guarde so na
# Vercel: quem tem esse valor forja sessao.
AUTH_SECRET=
# URL publica da aplicacao (ex.: http://localhost:3000 em desenvolvimento,
# https://appfin.vercel.app em producao). Em producao sem AUTH_URL o Auth.js
# recusa subir com `UntrustedHost` — e falha alto de proposito.
AUTH_URL=
# Allowlist fixa: exatamente os 2 e-mails do household, separados por virgula
# (RNF-01). E-mail fora desta lista e recusado no login.
AUTH_ALLOWED_EMAILS=

# --- Envio do magic link (T-004) ---
# Transporte SMTP no formato smtp://usuario:senha@host:porta.
# Exemplo com Gmail + senha de app (sem dominio proprio, ver docs/DEPLOY.md §2):
#   EMAIL_SERVER=smtp://SEU_USUARIO%40gmail.com:SENHA_DE_APP@smtp.gmail.com:587
# Com dominio proprio, o Resend tambem serve:
#   EMAIL_SERVER=smtp://resend:SUA_CHAVE_API@smtp.resend.com:587
# Vazio em DESENVOLVIMENTO: o magic link e impresso no console do servidor,
# marcado com "[DEV] magic link (SMTP nao configurado)". Troca so o canal de
# entrega — o token continua real, gravado e com a mesma expiracao, e a
# allowlist continua recusando endereco de fora.
# OBRIGATORIO em PRODUCAO: sem ele o app se recusa a iniciar. Nunca imprime o
# link no log de producao — isso entregaria credencial de acesso a quem lesse o
# log do servidor.
EMAIL_SERVER=
# Remetente exibido no e-mail de login (ex.: APPFIN <login@seu-dominio>).
EMAIL_FROM=
